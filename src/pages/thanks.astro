---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you | Shameer SN" description="Your message was sent." noindex>
  <section class="container" style="padding-top: 96px; padding-bottom: 96px">
    <div class="stack gap-24" style="gap: 20px; max-width: 640px">
      <p class="label">Message sent</p>
      <h1>Thank you.</h1>
      <p class="lead">I got your message. I usually reply within a couple of days.</p>
      <div><a class="btn btn-secondary" href="/">Back to home</a></div>
    </div>
  </section>
</Base>
