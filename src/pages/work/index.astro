---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import CTA from '../../components/CTA.astro';

const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Work | Shameer SN"
  description="Three case studies: an AWS platform for a care app, a platform with 700+ APIs, and a notification system. Client names are left out."
  current="work"
>
  <section class="container intro stack gap-16">
    <p class="label">Work</p>
    <h1 style="max-width: 820px">Some things I've worked on</h1>
    <p class="lead" style="max-width: 720px">Client names are left out. Each case study covers the problem, what I did, and what came out of it.</p>
  </section>

  <section class="container list stack reveal" style="gap: 20px" aria-label="Case studies">
    {cases.map((c) => (
      <CaseCard variant="list" href={`/work/${c.id}`} label={c.data.list.label} title={c.data.list.title} dates={c.data.list.dates} text={c.data.list.text} tags={c.data.tags} />
    ))}
  </section>

  <CTA title="Working on something similar? Happy to talk it through." size="sm" width="560px" />
</Base>

<style>
  .intro { padding-top: 80px; padding-bottom: 40px; }
  .list { padding-bottom: 96px; }
  @media (max-width: 720px) { .intro { padding-top: 48px; } .list { padding-bottom: 64px; } }
</style>
