---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Shameer SN" description="This page does not exist." noindex>
  <section class="container" style="padding-top: 96px; padding-bottom: 96px">
    <div class="stack gap-24" style="gap: 20px; max-width: 640px">
      <p class="label">404</p>
      <h1>This page does not exist.</h1>
      <p class="lead">The link may be old or mistyped. Try one of these.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-secondary" href="/work">Work</a>
        <a class="btn btn-secondary" href="/about#contact">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
