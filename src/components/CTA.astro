---
interface Props { title: string; text?: string; size?: 'lg' | 'md' | 'sm'; width?: string }
const { title, text, size = 'md', width = '620px' } = Astro.props;
const cls = size === 'lg' ? '' : size === 'md' ? 'h2-md' : 'h2-sm';
---
<section class="night cta">
  <div class="container cta-in reveal">
    <div class="stack gap-12" style={`max-width: ${width}`}>
      <h2 class={cls}>{title}</h2>
      {text && <p class="sub">{text}</p>}
    </div>
    <a href="/about#contact" class="btn btn-night">Get in touch</a>
  </div>
</section>

<style>
  .cta-in { padding-top: 72px; padding-bottom: 72px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 32px; }
  @media (max-width: 720px) { .cta-in { padding-top: 56px; padding-bottom: 56px; } }
</style>
