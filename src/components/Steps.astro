---
const steps = [
  { title: 'We talk', text: "You tell me the problem. I tell you honestly if I'm the right person for it." },
  { title: 'I write a short plan', text: "What we'll build, how long it should take, and what could go wrong." },
  { title: 'We build in small pieces', text: 'You see something working every week.' },
  { title: 'You get everything', text: 'Code, accounts, docs and a recorded walkthrough.' },
];
---
<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <p class="label accent">STEP {i + 1}</p>
      <p class="t">{s.title}</p>
      <p class="muted">{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 24px; }
  li { border-top: 2px solid var(--ink); padding-top: 16px; }
  .t { margin: 6px 0; font-size: 20px; font-weight: 600; }
</style>
